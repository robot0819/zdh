# ====================================
# Filebrowser 部署配置文件
# ====================================

# ----------- Filebrowser 配置 -----------
export FB_PORT=8080
export FB_ROOT=/root
export FB_USER=admin
export FB_PASS=adminadmin123

# ----------- Nginx 配置 -----------
export NGINX_DOMAIN=files.example.com
export NGINX_PORT=80
export ENABLE_SSL=false
export SSL_EMAIL=your-email@example.com

# ----------- FRP 服务端配置 -----------
export FRP_VERSION=0.58.1
export FRPS_BIND_PORT=7000
export FRPS_VHOST_HTTP_PORT=8080
export FRPS_VHOST_HTTPS_PORT=8443
export FRPS_DASHBOARD_PORT=7500
export FRPS_DASHBOARD_USER=admin
export FRPS_DASHBOARD_PWD=admin123456
# export FRPS_TOKEN=your-token-here  # 留空自动生成

# ----------- FRP 客户端配置 -----------
export FRPS_SERVER_ADDR=your-server-ip
export FRPS_SERVER_PORT=7000
export FRPS_TOKEN=your-token-from-server
export FRPC_LOCAL_PORT=8080
export FRPC_PROXY_NAME=filebrowser
export FRPC_PROXY_TYPE=http  # http 或 tcp
export FRPC_CUSTOM_DOMAIN=files.example.com  # HTTP模式使用
export FRPC_REMOTE_PORT=8080  # TCP模式使用
